{
  "crons": [
    {
      "path": "/api/cron/outreach",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/billing-clerk",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/n8n_course/:chapter",
      "destination": "/n8n_course/:chapter.html"
    },
    {
      "source": "/ebook/:slug",
      "destination": "/E-Books/:slug.html"
    },
    {
      "source": "/posts/:slug",
      "destination": "/posts/:slug.html"
    },
    {
      "source": "/Web3",
      "destination": "/Web3/index.html"
    }
  ]
}
