// Zenith Lab — paid access / entitlements / progress schema.
// Postgres (Neon / Vercel Postgres). Auth.js tables (User/Account/Session/
// VerificationToken) follow the Prisma adapter's required shape exactly:
// https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Real, DB-backed admin role — additive alongside the existing ADMIN_EMAILS
  // env-var allowlist in src/lib/admin.ts (kept as a fallback during
  // transition, not removed). Defaults every existing and new row to CLIENT,
  // so this migration needs no backfill logic.
  role UserRole @default(CLIENT)

  // The stronger, stable Whop identity (Phase 5) — populated the first time a
  // webhook resolves this email to a Whop user. Preferred over email for
  // matching once known, since email can be legitimately reused/changed.
  whopUserId String? @unique

  // AES-256-GCM ciphertext (see src/lib/password.ts), decryptable only with
  // PASSWORD_ENCRYPTION_KEY — a server-only secret never stored in this
  // database. Set automatically by the webhook the moment a purchase
  // completes, and shown back on /profile any time. Nullable — accounts
  // created before this existed may still have none.
  passwordEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  entitlements    CourseEntitlement[]
  progress        CourseProgress[]
  serviceRequests ServiceRequest[]
  purchaseClaims  PurchaseClaim[]
  proposals       Proposal[]
  serviceProjects ServiceProject[]
  clientDocuments ClientDocument[]
  serviceMessages ServiceMessage[]
  supportRequests SupportRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// "User X owns course Y" — the single server-authoritative fact the whole
// access-control system hangs off. courseId matches the id in src/lib/courses.ts.
model CourseEntitlement {
  id       String @id @default(cuid())
  userId   String
  courseId String

  status String @default("active") // "active" | "revoked"
  source String @default("whop")

  whopMembershipId String?
  whopPaymentId     String?

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

// Bridges the Whop-hosted checkout redirect (which only proves "a payment
// with this id succeeded", via Whop's own status=success&payment_id=...
// query params) back to a specific local User, so the buyer's browser can
// land signed in on /dashboard with zero typing. One row per payment.
model PurchaseClaim {
  id        String    @id @default(cuid())
  paymentId String    @unique
  userId    String
  claimedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Idempotency ledger. Primary key IS Whop's `webhook-id` header — a retried
// delivery reuses the same id, so a duplicate insert fails on the PK
// constraint and is treated as "already processed" before any business
// logic runs. See doc §3.7 (at-least-once delivery).
model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
  payload    Json
}

// Mirrors course-progress.js's existing localStorage shape exactly:
// { modules: { [id]: {answers,score,total,completed,sections,...} }, extra: {...} }
// Server-stored per (user, course) so it syncs across devices. This is
// shape-validated on write, not proof of genuine completion — see the
// "Progress" section of the final report for why that distinction matters.
model CourseProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// AI Systems (done-for-you agency work) — a purchase here doesn't unlock a
// file, it starts a bespoke build tracked through 5 stages. status (build
// progress) and monthlyStatus (retainer billing) are independent: a live
// system's monthlyStatus can later go to "canceled" without erasing that
// it was ever built. serviceId matches src/lib/services.ts's id.
model ServiceRequest {
  id       String @id @default(cuid())
  userId   String
  serviceId String

  status        String @default("new")      // new | scoping | building | live | maintenance
  monthlyStatus String @default("inactive") // inactive | active | canceled

  whopSetupPaymentId      String?
  whopSetupMembershipId   String?
  whopMonthlyMembershipId String?

  adminNote String? @db.Text // internal only — never read by the client dashboard

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([whopMonthlyMembershipId])
}

// DB-backed mirror of src/lib/services.ts's static SERVICES array (Slice 2 of
// the service-platform build, 2026-08-27). Read-through only for now: this
// table is seeded from SERVICES (scripts/seed-service-catalog.mjs) so its
// shape can be proven before anything depends on it, but services.ts stays
// the real source of truth for checkout URLs, webhook plan resolution, and
// all current UI. slug matches the free-string service ids already in use
// (SERVICES[].id / ServiceRequest.serviceId), e.g. "ai-inbox-manager".
model ServiceCatalog {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  pitch       String
  description String @db.Text

  setupPriceCents   Int?
  monthlyPriceCents Int?

  whopSetupPlanId   String?
  whopMonthlyPlanId String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditRecommendations AuditRecommendation[]
  proposalItems        ProposalItem[]
  serviceProjects      ServiceProject[]
}

enum AuditStatus {
  SUBMITTED
  IN_REVIEW
  PROPOSAL_SENT
  ACCEPTED
  DECLINED
}

// Free audit intake (Slice 3 of the service-platform build, 2026-08-28).
// Stands alone for now, keyed by email only — no ClientProfile model exists
// yet (a later slice), so clientProfileId is deliberately omitted here.
// formAnswers holds the entire structured multi-step form submission as one
// JSON blob rather than a column per field, since the form has ~20 fields
// across 4 sections and the schema shouldn't need a migration every time a
// form question changes.
model AuditRequest {
  id          String      @id @default(cuid())
  email       String
  name        String?
  companyName String?
  formAnswers Json
  status      AuditStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings        AuditFinding[]
  recommendations AuditRecommendation[]
  proposals       Proposal[]

  @@index([email])
  @@index([status])
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// A single diagnosed issue surfaced during an admin's review of an
// AuditRequest submission (Slice 4 of the service-platform build,
// 2026-08-28). Purely additive — new table, FK to AuditRequest with cascade
// delete so deleting an audit cleans up its findings.
model AuditFinding {
  id                  String          @id @default(cuid())
  auditId             String
  title               String
  severity            FindingSeverity
  description         String          @db.Text
  currentImpact       String          @db.Text
  recommendedSolution String          @db.Text
  createdAt           DateTime        @default(now())

  audit AuditRequest @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

// A recommended next step tied to an audit review, optionally linking a real
// ServiceCatalog offering — nullable since not every recommendation maps to
// an existing catalog service (e.g. a bespoke build not yet cataloged).
model AuditRecommendation {
  id               String                  @id @default(cuid())
  auditId          String
  catalogServiceId String?
  title            String
  priority         RecommendationPriority
  rationale        String                  @db.Text
  expectedOutcome  String                  @db.Text
  estimatedEffort  String
  createdAt        DateTime                @default(now())

  audit          AuditRequest    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  catalogService ServiceCatalog? @relation(fields: [catalogServiceId], references: [id])

  @@index([auditId])
  @@index([catalogServiceId])
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  CHANGES_REQUESTED
  APPROVED
  DECLINED
  EXPIRED
}

// Proposal document (Slice 5 of the service-platform build, 2026-08-28).
// Created from an admin's review of an AuditRequest (auditId always set in
// practice for this slice's UI entry point), but modeled nullable so a
// future proposal could exist without one. clientEmail is always known even
// before any User account exists — backfilled from AuditRequest.email on
// creation. accessToken is the entire security mechanism for the
// client-facing view: a long random unguessable string, modeled directly on
// PurchaseClaim's token-based, no-signin-required pattern (see
// src/app/api/auth/claim/route.ts) rather than requiring a client session.
// Every Text section below is nullable at the DB level so an admin can save
// a draft with some sections still blank; the builder UI defaults them to
// empty strings.
model Proposal {
  id      String  @id @default(cuid())
  auditId String?
  userId  String?

  clientEmail String
  clientName  String?
  companyName String?

  status      ProposalStatus @default(DRAFT)
  accessToken String         @unique

  sentAt    DateTime?
  viewedAt  DateTime?
  expiresAt DateTime?

  executiveSummary    String? @db.Text
  currentChallenges   String? @db.Text
  recommendedSolution String? @db.Text
  scopeOfWork         String? @db.Text
  deliverables        String? @db.Text
  implementationPlan  String? @db.Text
  timeline            String? @db.Text
  assumptions         String? @db.Text
  notIncluded         String? @db.Text
  nextSteps           String? @db.Text
  terms               String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audit    AuditRequest?     @relation(fields: [auditId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  items    ProposalItem[]
  versions ProposalVersion[]
  approvals ClientApproval[]
  serviceProjects ServiceProject[]

  @@index([auditId])
  @@index([userId])
}

enum ProposalItemKind {
  SETUP
  MONTHLY
  PER_UNIT
  CUSTOM
  DISCOUNT
}

// Line item covering the brief's PRICING and OPTIONAL ADD-ONS sections.
// amountCents is negative for a DISCOUNT kind so totals sum correctly
// without special-casing subtraction anywhere that reads these rows.
model ProposalItem {
  id         String @id @default(cuid())
  proposalId String

  label            String
  kind             ProposalItemKind
  amountCents      Int
  unitLabel        String?
  isOptionalAddOn  Boolean @default(false)
  order            Int     @default(0)
  catalogServiceId String?

  proposal       Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  catalogService ServiceCatalog? @relation(fields: [catalogServiceId], references: [id])

  @@index([proposalId])
}

// Immutable history: every time an admin sends (or re-sends after edits) a
// proposal, the current Proposal + ProposalItem state is snapshotted here
// before/alongside updating the live Proposal row, so a client-visible
// proposal is never silently overwritten out from under a client who's
// already responded to a prior version.
model ProposalVersion {
  id            String   @id @default(cuid())
  proposalId    String
  versionNumber Int
  snapshot      Json
  createdAt     DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

enum ClientApprovalAction {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

// One row per client response via the token-secured public link — no
// userId requirement, since the client responding may have no account at
// all. ipAddress is best-effort (request.headers.get("x-forwarded-for")),
// never blocking on failure to obtain one.
model ClientApproval {
  id         String                @id @default(cuid())
  proposalId String
  action     ClientApprovalAction
  note       String?               @db.Text
  respondedAt DateTime             @default(now())
  ipAddress  String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

enum ProjectStage {
  NEW
  SCOPING
  ONBOARDING
  BUILDING
  QA
  LIVE
  MAINTENANCE
  PAUSED
  COMPLETED
  CANCELLED
}

// The actual delivery workspace for a service engagement (Slice 6 of the
// service-platform build, 2026-08-28). Purely additive and lives alongside
// ServiceRequest — it does NOT replace it in this slice. ServiceRequest
// keeps being the only thing the webhook writes for the 3 generic AI
// Systems services; ServiceProject is created by two new triggers only:
// (1) a client approving a Proposal via the token-secured public view, and
// (2) a Whop purchase of the "law-firms"/"brokerages" vertical offers
// specifically. catalogServiceId and sourceServiceId are both nullable and
// independent: a proposal-driven project may set catalogServiceId (from a
// ProposalItem's linked ServiceCatalog row) with no sourceServiceId, while
// a webhook-driven project sets sourceServiceId (the free-string
// src/lib/services.ts id, e.g. "law-firms") with no catalogServiceId, since
// those two vertical offers don't yet have ServiceCatalog rows of their
// own. No @@unique([userId, ...]) constraint on purpose — unlike
// ServiceRequest, a client can have more than one project over time (e.g.
// a second, later engagement); the webhook branch enforces its own
// re-buy idempotency via a findFirst check instead of a DB constraint.
model ServiceProject {
  id               String  @id @default(cuid())
  userId           String
  catalogServiceId String?
  proposalId       String?
  sourceServiceId  String?

  stage ProjectStage @default(NEW)
  title String

  adminNote String? @db.Text // internal only — never shown to the client, matches ServiceRequest.adminNote's convention

  whopMonthlyMembershipId String? // only set for webhook-sourced projects

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogService ServiceCatalog? @relation(fields: [catalogServiceId], references: [id])
  proposal       Proposal?       @relation(fields: [proposalId], references: [id])

  milestones      ProjectMilestone[]
  requirements    ClientRequirement[]
  integrations    Integration[]
  metrics         ServiceMetric[]
  documents       ClientDocument[]
  messages        ServiceMessage[]
  supportRequests SupportRequest[]

  @@index([userId])
  @@index([proposalId])
  @@index([sourceServiceId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  order       Int       @default(0)

  project ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum RequirementStatus {
  MISSING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Doubles as both "what we need from the client" and the onboarding
// checklist — same underlying concept (things the client needs to
// provide/confirm before/during build), deliberately not split into two
// models.
model ClientRequirement {
  id        String             @id @default(cuid())
  projectId String
  label     String
  detail    String?            @db.Text
  status    RequirementStatus  @default(MISSING)
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  project ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum IntegrationStatus {
  NOT_CONNECTED
  REQUESTED
  CONNECTED
  ERROR
  DISCONNECTED
}

// Client-facing rendering of this model must NEVER show anything beyond
// `provider` and a coarse status label (see the business brief's client-safe
// label set: "Connected" / "Action required" / "Connection issue" /
// "Not connected" / "Disconnected"). `externalRef` is an opaque
// reference/id ONLY — e.g. a CRM object id or a webhook subscription id —
// and must NEVER hold a raw secret, credential, API key, or OAuth token.
// There is no secrets-storage infrastructure in this codebase; if a real
// integration ever needs to persist a credential, that is its own dedicated
// slice with a real secrets manager, not a field on this table.
model Integration {
  id          String             @id @default(cuid())
  projectId   String
  provider    String // e.g. "gmail", "twilio", "crm"
  status      IntegrationStatus  @default(NOT_CONNECTED)
  externalRef String? // opaque reference/id ONLY — never a raw secret, credential, API key, or token
  connectedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Free-string `key` per the business brief's Phase 9 service-specific metric
// list (e.g. "leads_received", "response_time_minutes"). No metrics-producing
// integration is wired up anywhere in this codebase yet (Slice 7,
// 2026-08-28) — every project's Performance tab is expected to show
// "Awaiting live data" today. That is correct, not a bug.
model ServiceMetric {
  id         String   @id @default(cuid())
  projectId  String
  key        String
  value      Float
  recordedAt DateTime @default(now())

  project ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, key, recordedAt])
}

enum DocumentKind {
  PROPOSAL
  AGREEMENT
  ONBOARDING
  REPORT
  DELIVERABLE
  OTHER
}

// File uploads are explicitly OUT OF SCOPE for Slice 7 — no storage provider
// (S3/Vercel Blob/Uploadthing/etc.) exists anywhere in this codebase, and
// standing one up is real infrastructure work deserving its own slice with
// the business owner's input on provider/cost. This table exists so the
// Files tab UI has a real (currently empty) list to render and is ready the
// moment storage is wired up; `storageKey`/`sizeBytes` are nullable because
// no row can be created with real values yet. `storageKey` NEVER holds file
// bytes — only a future key into whatever blob store is eventually chosen.
model ClientDocument {
  id         String       @id @default(cuid())
  projectId  String
  userId     String // uploader
  filename   String
  storageKey String? // key into a future blob store — always null today, see model comment
  sizeBytes  Int?
  kind       DocumentKind @default(OTHER)
  createdAt  DateTime     @default(now())

  project ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum MessageSenderRole {
  CLIENT
  ADMIN
}

// senderRole is stored explicitly at write time (rather than derived from
// senderUserId + a role lookup on every render) since it drives who a
// message is attributed to in the UI and is cheap to set correctly once,
// at the point where the sender's own role is unambiguous.
model ServiceMessage {
  id           String            @id @default(cuid())
  projectId    String
  senderUserId String
  senderRole   MessageSenderRole
  body         String            @db.Text
  createdAt    DateTime          @default(now())

  project ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

// projectId is nullable — a support request may not always be tied to a
// specific project (e.g. a general account question).
model SupportRequest {
  id        String          @id @default(cuid())
  projectId String?
  userId    String
  subject   String
  body      String          @db.Text
  priority  SupportPriority @default(MEDIUM)
  status    SupportStatus   @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project ServiceProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}
