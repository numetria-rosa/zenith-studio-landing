// Zenith Lab — paid access / entitlements / progress schema.
// Postgres (Neon / Vercel Postgres). Auth.js tables (User/Account/Session/
// VerificationToken) follow the Prisma adapter's required shape exactly:
// https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Real, DB-backed admin role — additive alongside the existing ADMIN_EMAILS
  // env-var allowlist in src/lib/admin.ts (kept as a fallback during
  // transition, not removed). Defaults every existing and new row to CLIENT,
  // so this migration needs no backfill logic.
  role UserRole @default(CLIENT)

  // The stronger, stable Whop identity (Phase 5) — populated the first time a
  // webhook resolves this email to a Whop user. Preferred over email for
  // matching once known, since email can be legitimately reused/changed.
  whopUserId String? @unique

  // AES-256-GCM ciphertext (see src/lib/password.ts), decryptable only with
  // PASSWORD_ENCRYPTION_KEY — a server-only secret never stored in this
  // database. Set automatically by the webhook the moment a purchase
  // completes, and shown back on /profile any time. Nullable — accounts
  // created before this existed may still have none.
  passwordEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  entitlements    CourseEntitlement[]
  progress        CourseProgress[]
  serviceRequests ServiceRequest[]
  purchaseClaims  PurchaseClaim[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// "User X owns course Y" — the single server-authoritative fact the whole
// access-control system hangs off. courseId matches the id in src/lib/courses.ts.
model CourseEntitlement {
  id       String @id @default(cuid())
  userId   String
  courseId String

  status String @default("active") // "active" | "revoked"
  source String @default("whop")

  whopMembershipId String?
  whopPaymentId     String?

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

// Bridges the Whop-hosted checkout redirect (which only proves "a payment
// with this id succeeded", via Whop's own status=success&payment_id=...
// query params) back to a specific local User, so the buyer's browser can
// land signed in on /dashboard with zero typing. One row per payment.
model PurchaseClaim {
  id        String    @id @default(cuid())
  paymentId String    @unique
  userId    String
  claimedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Idempotency ledger. Primary key IS Whop's `webhook-id` header — a retried
// delivery reuses the same id, so a duplicate insert fails on the PK
// constraint and is treated as "already processed" before any business
// logic runs. See doc §3.7 (at-least-once delivery).
model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
  payload    Json
}

// Mirrors course-progress.js's existing localStorage shape exactly:
// { modules: { [id]: {answers,score,total,completed,sections,...} }, extra: {...} }
// Server-stored per (user, course) so it syncs across devices. This is
// shape-validated on write, not proof of genuine completion — see the
// "Progress" section of the final report for why that distinction matters.
model CourseProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// AI Systems (done-for-you agency work) — a purchase here doesn't unlock a
// file, it starts a bespoke build tracked through 5 stages. status (build
// progress) and monthlyStatus (retainer billing) are independent: a live
// system's monthlyStatus can later go to "canceled" without erasing that
// it was ever built. serviceId matches src/lib/services.ts's id.
model ServiceRequest {
  id       String @id @default(cuid())
  userId   String
  serviceId String

  status        String @default("new")      // new | scoping | building | live | maintenance
  monthlyStatus String @default("inactive") // inactive | active | canceled

  whopSetupPaymentId      String?
  whopSetupMembershipId   String?
  whopMonthlyMembershipId String?

  adminNote String? @db.Text // internal only — never read by the client dashboard

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([whopMonthlyMembershipId])
}

// DB-backed mirror of src/lib/services.ts's static SERVICES array (Slice 2 of
// the service-platform build, 2026-08-27). Read-through only for now: this
// table is seeded from SERVICES (scripts/seed-service-catalog.mjs) so its
// shape can be proven before anything depends on it, but services.ts stays
// the real source of truth for checkout URLs, webhook plan resolution, and
// all current UI. slug matches the free-string service ids already in use
// (SERVICES[].id / ServiceRequest.serviceId), e.g. "ai-inbox-manager".
model ServiceCatalog {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  pitch       String
  description String @db.Text

  setupPriceCents   Int?
  monthlyPriceCents Int?

  whopSetupPlanId   String?
  whopMonthlyPlanId String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditRecommendations AuditRecommendation[]
}

enum AuditStatus {
  SUBMITTED
  IN_REVIEW
  PROPOSAL_SENT
  ACCEPTED
  DECLINED
}

// Free audit intake (Slice 3 of the service-platform build, 2026-08-28).
// Stands alone for now, keyed by email only — no ClientProfile model exists
// yet (a later slice), so clientProfileId is deliberately omitted here.
// formAnswers holds the entire structured multi-step form submission as one
// JSON blob rather than a column per field, since the form has ~20 fields
// across 4 sections and the schema shouldn't need a migration every time a
// form question changes.
model AuditRequest {
  id          String      @id @default(cuid())
  email       String
  name        String?
  companyName String?
  formAnswers Json
  status      AuditStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings        AuditFinding[]
  recommendations AuditRecommendation[]

  @@index([email])
  @@index([status])
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// A single diagnosed issue surfaced during an admin's review of an
// AuditRequest submission (Slice 4 of the service-platform build,
// 2026-08-28). Purely additive — new table, FK to AuditRequest with cascade
// delete so deleting an audit cleans up its findings.
model AuditFinding {
  id                  String          @id @default(cuid())
  auditId             String
  title               String
  severity            FindingSeverity
  description         String          @db.Text
  currentImpact       String          @db.Text
  recommendedSolution String          @db.Text
  createdAt           DateTime        @default(now())

  audit AuditRequest @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

// A recommended next step tied to an audit review, optionally linking a real
// ServiceCatalog offering — nullable since not every recommendation maps to
// an existing catalog service (e.g. a bespoke build not yet cataloged).
model AuditRecommendation {
  id               String                  @id @default(cuid())
  auditId          String
  catalogServiceId String?
  title            String
  priority         RecommendationPriority
  rationale        String                  @db.Text
  expectedOutcome  String                  @db.Text
  estimatedEffort  String
  createdAt        DateTime                @default(now())

  audit          AuditRequest    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  catalogService ServiceCatalog? @relation(fields: [catalogServiceId], references: [id])

  @@index([auditId])
  @@index([catalogServiceId])
}
