// Zenith Lab — paid access / entitlements / progress schema.
// Postgres (Neon / Vercel Postgres). Auth.js tables (User/Account/Session/
// VerificationToken) follow the Prisma adapter's required shape exactly:
// https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // The stronger, stable Whop identity (Phase 5) — populated the first time a
  // webhook resolves this email to a Whop user. Preferred over email for
  // matching once known, since email can be legitimately reused/changed.
  whopUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  entitlements    CourseEntitlement[]
  progress        CourseProgress[]
  serviceRequests ServiceRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// "User X owns course Y" — the single server-authoritative fact the whole
// access-control system hangs off. courseId matches the id in src/lib/courses.ts.
model CourseEntitlement {
  id       String @id @default(cuid())
  userId   String
  courseId String

  status String @default("active") // "active" | "revoked"
  source String @default("whop")

  whopMembershipId String?
  whopPaymentId     String?

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

// Idempotency ledger. Primary key IS Whop's `webhook-id` header — a retried
// delivery reuses the same id, so a duplicate insert fails on the PK
// constraint and is treated as "already processed" before any business
// logic runs. See doc §3.7 (at-least-once delivery).
model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
  payload    Json
}

// Mirrors course-progress.js's existing localStorage shape exactly:
// { modules: { [id]: {answers,score,total,completed,sections,...} }, extra: {...} }
// Server-stored per (user, course) so it syncs across devices. This is
// shape-validated on write, not proof of genuine completion — see the
// "Progress" section of the final report for why that distinction matters.
model CourseProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// AI Systems (done-for-you agency work) — a purchase here doesn't unlock a
// file, it starts a bespoke build tracked through 5 stages. status (build
// progress) and monthlyStatus (retainer billing) are independent: a live
// system's monthlyStatus can later go to "canceled" without erasing that
// it was ever built. serviceId matches src/lib/services.ts's id.
model ServiceRequest {
  id       String @id @default(cuid())
  userId   String
  serviceId String

  status        String @default("new")      // new | scoping | building | live | maintenance
  monthlyStatus String @default("inactive") // inactive | active | canceled

  whopSetupPaymentId      String?
  whopSetupMembershipId   String?
  whopMonthlyMembershipId String?

  adminNote String? @db.Text // internal only — never read by the client dashboard

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([whopMonthlyMembershipId])
}
