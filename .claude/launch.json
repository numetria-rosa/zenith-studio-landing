{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zenith-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "ai-engineering-course",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8791",
        "--directory",
        "courses/ai-engineering"
      ],
      "port": 8791
    },
    {
      "name": "aie-visual",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/visual/dev-server.mjs"
      ],
      "port": 3100
    },
    {
      "name": "aie-real",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/visual/dev-server.mjs",
        "real"
      ],
      "port": 3100
    }
  ]
}